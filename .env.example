# ---------------------------------------------------------------------------
# Payo Billiard — environment variables
# Copy to .env.local (local) and set the same keys in Vercel (production).
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable / anon key (safe for the browser; protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL of the site (used for auth email links, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NOT used by the app yet; reserved for trusted admin jobs.
# Never prefix with NEXT_PUBLIC_ and never import it in client code.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: map tile URL template (Leaflet). Defaults to the public OpenStreetMap
# tile server, which is fine for development but not for heavy production
# traffic — use a provider such as MapTiler or Stadia (with its key) instead.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=YOUR_KEY

# Optional: Google Maps Platform (much more complete place data in Indonesia).
# When set, maps + place search switch from OpenStreetMap to Google.
# Restrict the key in Google Cloud: HTTP referrers = your domains, APIs =
# Maps JavaScript API, Places API (New), Geocoding API.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud → Map Management). "DEMO_MAP_ID" works for development.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
